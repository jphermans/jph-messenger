# JPH Messenger - Example Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env

# =============================================================================
# Agent Zero Configuration
# =============================================================================

# URL to your Agent Zero instance
# - If A0 runs on the same server: http://localhost:80
# - If A0 runs in Docker on same host: http://host.docker.internal:80
# - If A0 runs on a different server: http://192.168.1.50:80
A0_API_URL=http://localhost:80

# Agent Zero API Key
# Get this from A0 WebUI: Settings → API → API Key
# Leave empty if Agent Zero is not configured (agent messages will fail gracefully)
A0_API_KEY=

# =============================================================================
# Gateway Server Configuration
# =============================================================================

# Server host (usually 0.0.0.0 for Docker)
HOST=0.0.0.0

# Server port
PORT=8080
